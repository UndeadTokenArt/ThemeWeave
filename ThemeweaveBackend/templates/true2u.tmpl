<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>true2u - Handcrafted Custom Jewelry</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
      body {
        font-family: "Inter", sans-serif;
        background-color: #fdfbf8; /* A very light, warm off-white */
      }
      h1,
      h2,
      h3,
      h4,
      h5,
      h6,
      .font-display {
        font-family: "Cormorant Garamond", serif;
      }
      .text-brand-gold {
        color: #b8860b; /* DarkGoldenRod */
      }
      .bg-brand-gold {
        background-color: #b8860b;
      }
      .border-brand-gold {
        border-color: #b8860b;
      }
      .btn {
        @apply inline-block px-8 py-3 text-sm font-semibold tracking-wider uppercase transition-colors duration-300 rounded-full;
      }
      .btn-primary {
        @apply bg-brand-gold text-white hover:bg-opacity-90;
      }
      .btn-secondary {
        @apply bg-transparent border-2 border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-white;
      }
      .gallery-item {
        @apply relative overflow-hidden rounded-lg shadow-sm cursor-pointer;
        transition: all 0.3s ease-in-out;
        align-content: center;
        max-height: 225pt;
        padding: 5pt;
        padding-top: 15pt;
      }
      .gallery-item:hover .gallery-overlay {
        opacity: 1;
      }
      .gallery-item:hover img {
        transform: scale(1.05);
      }
      .gallery-overlay {
        @apply absolute inset-0 flex items-center justify-center p-4 text-center text-white bg-black bg-opacity-60 opacity-0 transition-opacity duration-300;
      }
      .gallery-item img {
        padding-top: 5pt;
        border-radius: 10pt;
        box-shadow: 0 5pt rgba(0, 0, 0, 0.1);
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .profile-image {
        padding: 5pt;
        object-fit: contain;
        max-width: 400pt;
        max-height: 400pt;
      }
      .font-bold {
        padding-top: 5pt;
        padding-bottom: 8pt;
        font-weight: bold;
        color: #b8860b;
      }
    </style>
  </head>
  <body class="text-gray-700">
    <!-- Header & Navigation -->
    <header
      id="home"
      class="sticky top-0 z-50 bg-white/80 backdrop-blur-lg shadow-sm"
    >
      <div class="container mx-auto px-6 py-4">
        <div class="flex items-center justify-between">
          <a
            href="#home"
            class="text-3xl font-bold font-display text-brand-gold"
            >True2u</a
          >
          <nav class="hidden md:flex items-center space-x-8">
            <a href="#about" class="hover:text-brand-gold transition-colors"
              >About</a
            >
            <a href="#gallery" class="hover:text-brand-gold transition-colors"
              >Gallery</a
            >
            <a href="#process" class="hover:text-brand-gold transition-colors"
              >Process</a
            >
            <a href="#contact" class="hover:text-brand-gold transition-colors"
              >Contact</a
            >
          </nav>
          <a
            href="https://www.etsy.com/shop/true2u/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary hidden md:inline-block"
            >Shop on Etsy</a
          >
          <button id="mobile-menu-button" class="md:hidden">
            <i data-lucide="menu" class="text-brand-gold"></i>
          </button>
        </div>
      </div>
      <!-- Mobile Menu -->
      <div id="mobile-menu" class="hidden md:hidden px-6 pb-4">
        <a
          href="#about"
          class="block py-2 hover:text-brand-gold transition-colors"
          >About</a
        >
        <a
          href="#gallery"
          class="block py-2 hover:text-brand-gold transition-colors"
          >Gallery</a
        >
        <a
          href="#process"
          class="block py-2 hover:text-brand-gold transition-colors"
          >Process</a
        >
        <a
          href="#contact"
          class="block py-2 hover:text-brand-gold transition-colors"
          >Contact</a
        >
        <a
          href="https://www.etsy.com/shop/true2u/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary w-full mt-4 text-center"
          >Shop on Etsy</a
        >
      </div>
    </header>

    <main>
      <!-- Hero Section -->
      <section
        class="relative h-[80vh] min-h-[500px] flex items-center justify-center text-white"
      >
        <div class="absolute inset-0 bg-black opacity-40 z-10"></div>
        <img
            src="/static/images/Hero.jpg"
          alt="Hero background image of a beautiful piece of jewelry"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="relative z-20 text-center px-4">
          <h1
            class="text-5xl md:text-7xl lg:text-8xl font-display mb-4 leading-tight"
          >
            Your Story, Cast in Gold
          </h1>
          <p class="max-w-2xl mx-auto text-lg md:text-xl mb-8 font-light">
            Exquisite, handcrafted jewelry made with passion, just for you.
          </p>
          <a
            href="https://www.etsy.com/shop/true2u/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            >Explore My Collection</a
          >
        </div>
      </section>

      <!-- Gallery Section -->
      <section id="gallery" class="py-20 md:py-32">
        <div class="container mx-auto px-6 text-center">
          <h2 class="text-4xl md:text-5xl font-display text-gray-800 mb-4">
            Handmade Treasures
          </h2>
          <p class="max-w-2xl mx-auto text-lg text-gray-600 mb-12">
            Explore a selection of my favorite creations. Each piece is crafted
            with love and attention to every detail.
          </p>

          <!-- Filter Buttons -->
          <div class="flex justify-center space-x-2 md:space-x-4 mb-12">
            <button class="gallery-filter-btn active" data-filter="all">
              All
            </button>
            <button class="gallery-filter-btn" data-filter="earrings">
              Earrings
            </button>
            <button class="gallery-filter-btn" data-filter="necklaces">
              Necklaces
            </button>
            <button class="gallery-filter-btn" data-filter="other">
              Other
            </button>
          </div>

          <!-- Gallery Grid -->
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
            
            {{ range .GalleryItems }}
            <div class="gallery-item" data-category="other">
              <a href="{{ .Link }}" target="_blank" rel="noopener noreferrer">
                <img
                  src="{{ .ImageURL }}"
                  alt="{{ .Title }}"
                />
              </a>
              <div class="gallery-overlay">
                <p class="font-bold text-brand-gold">
                  {{ .Title }}
                </p>
              </div>
            </div>
            {{ end }}
            
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section id="about" class="py-20 md:py-32 bg-white">
        <div class="container mx-auto px-6">
          <div class="grid sm:grid-cols-2 gap-12 lg:gap-20 items-center">
            <div class="rounded-lg overflow-hidden shadow-xl">
              <div class="profile-image">
                <img src="/static/images/ProfilePhoto.png" alt="Photo of the jewelry artist" />
              </div>
            </div>
            <div class="text-center md:text-left">
              <h2 class="text-4xl md:text-5xl font-display text-gray-800 mb-6">
                Crafted with Heart & Soul
              </h2>
              <p class="mb-4 text-lg text-gray-600">
                Hi, I'm Tiffany, the hands and heart behind Aura Jewels. For me,
                jewelry is more than just an accessory—it's a tiny sculpture, a
                wearable piece of art that holds meaning and memory.
              </p>
              <p class="mb-4 text-gray-600">
                I fell in love with metalworking years ago, fascinated by the
                process of transforming raw metal and stone into something
                beautiful and enduring. Every piece in my collection is
                meticulously handcrafted in my little studio, with a focus on
                quality, ethical materials, and timeless design.
              </p>
              <p class="mb-8 text-gray-600">
                My greatest joy is creating custom pieces that tell your unique
                story. Whether it's an engagement ring that symbolizes a new
                beginning or a necklace that commemorates a special moment, I'm
                honored to be a part of your journey.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Process Section -->
      <section id="process" class="py-20 md:py-32 bg-white">
        <div class="container mx-auto px-6 text-center">
          <h2 class="text-4xl md:text-5xl font-display text-gray-800 mb-4">
            The Custom Creation Process
          </h2>
          <p class="max-w-2xl mx-auto text-lg text-gray-600 mb-16">
            Bringing your dream jewelry to life is a collaborative and magical
            journey. Here’s how it works.
          </p>
          <div class="grid md:grid-cols-4 gap-12 text-center">
            <div class="flex flex-col items-center">
              <div
                class="w-20 h-20 mb-6 bg-rose-50 flex items-center justify-center rounded-full text-brand-gold"
              >
                <i data-lucide="message-square" class="w-10 h-10"></i>
              </div>
              <h3 class="text-xl font-display mb-2 text-gray-800">
                1. Consultation
              </h3>
              <p class="text-gray-600">
                We'll chat about your vision, ideas, materials, and budget to
                understand exactly what you're looking for.
              </p>
            </div>
            <div class="flex flex-col items-center">
              <div
                class="w-20 h-20 mb-6 bg-rose-50 flex items-center justify-center rounded-full text-brand-gold"
              >
                <i data-lucide="pencil-ruler" class="w-10 h-10"></i>
              </div>
              <h3 class="text-xl font-display mb-2 text-gray-800">
                2. Design & Sketch
              </h3>
              <p class="text-gray-600">
                I'll create detailed sketches or digital mockups for your
                approval, refining the design until it's perfect.
              </p>
            </div>
            <div class="flex flex-col items-center">
              <div
                class="w-20 h-20 mb-6 bg-rose-50 flex items-center justify-center rounded-full text-brand-gold"
              >
                <i data-lucide="gem" class="w-10 h-10"></i>
              </div>
              <h3 class="text-xl font-display mb-2 text-gray-800">
                3. Creation
              </h3>
              <p class="text-gray-600">
                Once the design is finalized, I'll begin the magic of
                handcrafting your piece with the utmost care and precision.
              </p>
            </div>
            <div class="flex flex-col items-center">
              <div
                class="w-20 h-20 mb-6 bg-rose-50 flex items-center justify-center rounded-full text-brand-gold"
              >
                <i data-lucide="sparkles" class="w-10 h-10"></i>
              </div>
              <h3 class="text-xl font-display mb-2 text-gray-800">
                4. Your Heirloom
              </h3>
              <p class="text-gray-600">
                Your one-of-a-kind piece is polished, beautifully packaged, and
                sent to you to be cherished for a lifetime.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Testimonials -->
      <section class="py-20 md:py-32">
        <div class="container mx-auto px-6 text-center">
          <h2 class="text-4xl md:text-5xl font-display text-gray-800 mb-12">
            Words from Happy Clients
          </h2>
          <div
            class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto"
          >
            <div class="bg-white p-8 rounded-lg shadow-sm">
              <p class="text-gray-600 mb-4 italic">
                "These are adorable!!!! The perfect weight. Love them."
              </p>
              <p class="font-bold text-brand-gold">Alica - Aug 18, 2025</p>
            </div>
            <div class="bg-white p-8 rounded-lg shadow-sm">
              <p class="text-gray-600 mb-4 italic">
                "Beautiful and exactly what I wanted."
              </p>
              <p class="font-bold text-brand-gold">shirly1150 - Aug 31,2025</p>
            </div>
            <div
              class="bg-white p-8 rounded-lg shadow-sm md:col-span-2 lg:col-span-1"
            >
              <p class="text-gray-600 mb-4 italic">
                "I am obsessed! These are gorgeous!"
              </p>
              <p class="font-bold text-brand-gold">Callie - Aug 23, 2025</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer id="contact" class="bg-white">
      <div class="container mx-auto px-6 py-16 text-center">
        <h2 class="text-4xl md:text-5xl font-display text-gray-800 mb-4">
          Let's Create Something Beautiful
        </h2>
        <p class="max-w-2xl mx-auto text-lg text-gray-600 mb-8">
          Have an idea for a custom piece or a question about my work? I'd love
          to hear from you.
        </p>
        <!-- <a href="mailto:hello@youremail.com" class="btn btn-primary mb-12"
          >hello@youremail.com</a> -->

        <!-- <div class="flex justify-center space-x-6 mb-8">
          <a
            href="#"
            class="text-gray-500 hover:text-brand-gold transition-colors"
            ><i data-lucide="instagram" class="w-6 h-6"></i
          ></a>
          <a
            href="#"
            class="text-gray-500 hover:text-brand-gold transition-colors"
            ><i data-lucide="facebook" class="w-6 h-6"></i
          ></a>
          <a
            href="#"
            class="text-gray-500 hover:text-brand-gold transition-colors"
            ><i data-lucide="pinterest" class="w-6 h-6"></i
          ></a>
        </div> -->

        <p class="text-gray-500 text-sm">
          &copy; <span id="year"></span> true2u. All Rights Reserved.
          Handcrafted with love.
        </p>
      </div>
    </footer>

    <script>
      // Initialize lucide icons
      lucide.createIcons();

      // Mobile menu toggle
      const mobileMenuButton = document.getElementById("mobile-menu-button");
      const mobileMenu = document.getElementById("mobile-menu");
      mobileMenuButton.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
      });

      // Set current year in footer
      document.getElementById("year").textContent = new Date().getFullYear();

      // Gallery filter logic
      const filterButtons = document.querySelectorAll(".gallery-filter-btn");
      const galleryItems = document.querySelectorAll(".gallery-item");

      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          // Manage active state for buttons
          filterButtons.forEach((btn) => btn.classList.remove("active"));
          button.classList.add("active");

          const filter = button.dataset.filter;

          galleryItems.forEach((item) => {
            if (filter === "all" || item.dataset.category === filter) {
              item.style.display = "block";
            } else {
              item.style.display = "none";
            }
          });
        });
      });

      // Style for active filter button
      const style = document.createElement("style");
      style.innerHTML = `
            .gallery-filter-btn {
                padding: 0.5rem 1.5rem;
                border-radius: 9999px;
                font-weight: 500;
                transition: all 0.2s ease-in-out;
                border: 2px solid transparent;
            }
            .gallery-filter-btn.active {
                background-color: #B8860B;
                color: white;
                border-color: #B8860B;
            }
            .gallery-filter-btn:not(.active):hover {
                color: #B8860B;
            }
        `;
      document.head.appendChild(style);
    </script>
  </body>
</html>
